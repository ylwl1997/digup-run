---
import '../styles/global.css';
import { SITE, type Lang, pathFor } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Locale-neutral path, e.g. `/` or `/what-is-digup/`. */
  canonicalPath: string;
  lang?: Lang;
  ogType?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath,
  lang = 'en',
  ogType = 'website',
  ogImage,
} = Astro.props;

const site = SITE.url;
const pagePath = pathFor(lang, canonicalPath);
const canonical = `${site}${pagePath}`;
const enUrl = `${site}${pathFor('en', canonicalPath)}`;
const zhUrl = `${site}${pathFor('zh', canonicalPath)}`;
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';
const path = Astro.url.pathname;

const isCurrent = (p: string) => {
  const localized = pathFor(lang, p);
  if (p === '/') return path === localized || path === localized.replace(/\/$/, '') + '/';
  return path === localized || path.startsWith(localized);
};

const label = (en: string, zh: string) => (lang === 'zh' ? zh : en);
const homeHref = pathFor(lang, '/');
const ogImageAbs = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${site}${ogImage}`
  : `${site}/media/digup/ui-mac-video-zebra.webp`;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="theme-color" content="#0d7a75" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href={homeHref}><img class="mark" src="/logo.svg" width="28" height="28" alt="" />digup.run</a>
        <nav class="nav" aria-label={label('Primary', '主导航')}>
          <a href={homeHref} aria-current={path === homeHref || path === '/zh' ? 'page' : undefined}>{label('Home', '首页')}</a>
          <a href={pathFor(lang, '/what-is-digup/')} aria-current={isCurrent('/what-is-digup/') ? 'page' : undefined}>{label('What is', '是什么')}</a>
          <details class="nav-group">
            <summary>{label('Install', '安装')}</summary>
            <div class="submenu">
              <a href={pathFor(lang, '/install-mac/')}>Mac</a>
              <a href={pathFor(lang, '/install-windows/')}>{label('Windows (beta)', 'Windows（测试）')}</a>
              <a href={pathFor(lang, '/install-linux/')}>{label('Linux (beta)', 'Linux（测试）')}</a>
            </div>
          </details>
          <a href={pathFor(lang, '/vs-spotlight/')} aria-current={isCurrent('/vs-spotlight/') ? 'page' : undefined}>{label('vs Spotlight', '对比 Spotlight')}</a>
          <a href={pathFor(lang, '/embeddinggemma-2/')} aria-current={isCurrent('/embeddinggemma-2/') ? 'page' : undefined}>EmbeddingGemma 2</a>
          <a href={pathFor(lang, '/faq/')} aria-current={isCurrent('/faq/') ? 'page' : undefined}>{label('FAQ', '常见问题')}</a>
          {lang === 'en' && (
            <a href="/changelog-notes/" aria-current={isCurrent('/changelog-notes/') ? 'page' : undefined}>Changelog</a>
          )}
        </nav>
        <div class="header-end">
          <div class="lang-switch" role="group" aria-label={label('Language', '语言')}>
            <a href={pathFor('en', canonicalPath)} class:list={['lang-opt', lang === 'en' && 'is-on']} hreflang="en" lang="en">EN</a>
            <a href={pathFor('zh', canonicalPath)} class:list={['lang-opt', lang === 'zh' && 'is-on']} hreflang="zh-CN" lang="zh-CN">中文</a>
          </div>
          <a class="cta" href={SITE.upstreamReleases} rel="noopener noreferrer">{label('GitHub Releases', 'GitHub Releases')}</a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer">
          {lang === 'zh' ? SITE.disclaimerZh : SITE.disclaimerEn}
          {' '}
          <a href={SITE.upstreamRepo} rel="noopener noreferrer">ARahim3/DigUp</a>
          {' · '}
          <a href={SITE.upstreamReleases} rel="noopener noreferrer">Releases</a>
        </p>
        <div class="footer-links">
          <a href={SITE.upstreamReleases} rel="noopener noreferrer">{label('Download on GitHub Releases', '前往 GitHub Releases 下载')}</a>
          <a href={SITE.upstreamRepo} rel="noopener noreferrer">{label('Upstream repo', '上游仓库')}</a>
          <a href={pathFor(lang, '/faq/')}>{label('FAQ', '常见问题')}</a>
          {lang === 'en' ? (
            <a href="/changelog-notes/">Changelog notes</a>
          ) : (
            <a href="/changelog-notes/" hreflang="en">{label('Changelog (EN)', '更新说明（英文）')}</a>
          )}
          <div class="lang-switch" role="group" aria-label={label('Language', '语言')}>
            <a href={pathFor('en', canonicalPath)} class:list={['lang-opt', lang === 'en' && 'is-on']} hreflang="en">EN</a>
            <a href={pathFor('zh', canonicalPath)} class:list={['lang-opt', lang === 'zh' && 'is-on']} hreflang="zh-CN">中文</a>
          </div>
        </div>
        <p class="tm">
          {lang === 'zh'
            ? 'DigUp 为 ARahim3 的项目。Gemma / EmbeddingGemma 为 Google LLC 商标。Mac 与 Spotlight 为 Apple Inc. 商标。本站不托管 DMG、EXE 或其他二进制文件。'
            : 'DigUp is a project by ARahim3. Gemma / EmbeddingGemma are trademarks of Google LLC. Mac and Spotlight are trademarks of Apple Inc. This site does not host DMG, EXE, or other binaries.'}
        </p>
      </div>
    </footer>
  </body>
</html>
