---
import '../styles/global.css';
import { SITE, type Lang, pathFor } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Locale-neutral path, e.g. `/` or `/what-is-digup/`. */
  canonicalPath: string;
  lang?: Lang;
  ogType?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath,
  lang = 'en',
  ogType = 'website',
  ogImage,
} = Astro.props;

const site = SITE.url;
const pagePath = pathFor(lang, canonicalPath);
const canonical = `${site}${pagePath}`;
const enUrl = `${site}${pathFor('en', canonicalPath)}`;
const zhUrl = `${site}${pathFor('zh', canonicalPath)}`;
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';
const path = Astro.url.pathname;

const isCurrent = (p: string) => {
  const localized = pathFor(lang, p);
  if (p === '/') return path === localized || path === localized.replace(/\/$/, '') + '/';
  return path === localized || path.startsWith(localized);
};

const label = (en: string, zh: string) => (lang === 'zh' ? zh : en);
const homeHref = pathFor(lang, '/');
const downloadHref = `${homeHref}#download`;
const ogImageAbs = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${site}${ogImage}`
  : `${site}/media/digup/ui-mac-video-zebra.webp`;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="theme-color" content="#070a0b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {SITE.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id: SITE.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href={homeHref}><img class="mark" src="/logo.svg" width="28" height="28" alt="" />DigUp</a>
        <nav class="nav" aria-label={label('Primary', '主导航')}>
          <a href={homeHref} aria-current={path === homeHref || path === '/zh' ? 'page' : undefined}>{label('Home', '首页')}</a>
          <a href={pathFor(lang, '/what-is-digup/')} aria-current={isCurrent('/what-is-digup/') ? 'page' : undefined}>{label('What is', '是什么')}</a>
          <details class="nav-group">
            <summary>{label('Install', '安装')}</summary>
            <div class="submenu">
              <a href={pathFor(lang, '/install-mac/')}>Mac</a>
              <a href={pathFor(lang, '/install-windows/')}>{label('Windows (beta)', 'Windows（测试）')}</a>
              <a href={pathFor(lang, '/install-linux/')}>{label('Linux (beta)', 'Linux（测试）')}</a>
            </div>
          </details>
          <a href={pathFor(lang, '/vs-spotlight/')} aria-current={isCurrent('/vs-spotlight/') ? 'page' : undefined}>{label('vs Spotlight', '对比 Spotlight')}</a>
          <a href={pathFor(lang, '/embeddinggemma-2/')} aria-current={isCurrent('/embeddinggemma-2/') ? 'page' : undefined}>EmbeddingGemma 2</a>
          <details class="nav-group">
            <summary>{label('Guides', '指南')}</summary>
            <div class="submenu">
              <a href={pathFor(lang, '/guides/zero-files-indexed/')}>{label('0 files indexed', '索引为 0')}</a>
              <a href={pathFor(lang, '/guides/battery-and-indexing-hours/')}>{label('Battery & hours', '耗电与时段')}</a>
              <a href={pathFor(lang, '/guides/win-linux-beta/')}>{label('Win/Linux beta', 'Win/Linux 测试')}</a>
            </div>
          </details>
          <a href={pathFor(lang, '/faq/')} aria-current={isCurrent('/faq/') ? 'page' : undefined}>{label('FAQ', '常见问题')}</a>
          {lang === 'en' && (
            <a href="/changelog-notes/" aria-current={isCurrent('/changelog-notes/') ? 'page' : undefined}>Changelog</a>
          )}
        </nav>
        <div class="header-end">
          <div class="lang-switch" role="group" aria-label={label('Language', '语言')}>
            <a href={pathFor('en', canonicalPath)} class:list={['lang-opt', lang === 'en' && 'is-on']} hreflang="en" lang="en">EN</a>
            <a href={pathFor('zh', canonicalPath)} class:list={['lang-opt', lang === 'zh' && 'is-on']} hreflang="zh-CN" lang="zh-CN">中文</a>
          </div>
          <a
            class="github-icon"
            href={SITE.upstreamRepo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label('DigUp on GitHub', 'DigUp 在 GitHub')}
          >
            <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
          </a>
          <a class="cta" href={downloadHref}>{label('Download', '下载')}</a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-links">
          <a href={downloadHref}>{label('Download DigUp', '下载 DigUp')}</a>
          <a href={SITE.upstreamRepo} rel="noopener noreferrer">ARahim3/DigUp</a>
          <a href={pathFor(lang, '/faq/')}>{label('FAQ', '常见问题')}</a>
          {lang === 'en' ? (
            <a href="/changelog-notes/">Changelog notes</a>
          ) : (
            <a href="/changelog-notes/" hreflang="en">{label('Changelog (EN)', '更新说明（英文）')}</a>
          )}
          <div class="lang-switch" role="group" aria-label={label('Language', '语言')}>
            <a href={pathFor('en', canonicalPath)} class:list={['lang-opt', lang === 'en' && 'is-on']} hreflang="en">EN</a>
            <a href={pathFor('zh', canonicalPath)} class:list={['lang-opt', lang === 'zh' && 'is-on']} hreflang="zh-CN">中文</a>
          </div>
        </div>
        <p class="disclaimer">{lang === 'zh' ? SITE.disclaimerZh : SITE.disclaimerEn}</p>
      </div>
    </footer>
    <!-- Adsterra Social Bar (friendly, dismissible) -->
    <script is:inline data-cfasync="false" src="https://bellnewyork.org/14/1d31e183906607cc75dcb5df922923ea"></script>
  </body>
</html>
