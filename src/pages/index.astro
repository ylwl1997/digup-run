---
import Layout from '../layouts/Layout.astro';
import { DIGUP_UI, SITE } from '../lib/site';
---
<Layout
  title="Digup Run — Download local multimodal semantic file search"
  description="Download Digup Run for Mac, Windows, and Linux. On-device EmbeddingGemma 2 search for photos, PDFs, audio, video, and code. Binaries from ylwl1997/digup-run-app Releases — this site hosts none."
  canonicalPath="/"
  lang="en"
  ogImage={DIGUP_UI.hero.src}
>
  <main>
    <section class="hero wrap">
      <div class="hero-split">
        <div class="hero-copy">
          <span class="badge">Digup Run · digup.run</span>
          <h1>Describe it. Dig it up on your machine.</h1>
          <ul class="job-steps" aria-label="How Digup Run works">
            <li><span class="n">1</span> Describe</li>
            <li class="arrow" aria-hidden="true">→</li>
            <li><span class="n">2</span> Hit content</li>
            <li class="arrow" aria-hidden="true">→</li>
            <li><span class="n">3</span> Open at page / time / line</li>
          </ul>
          <p class="lede">
            <strong>Digup Run</strong> is local-first multimodal semantic file search.
            Natural language finds what’s <em>inside</em> photos, PDFs, docs, audio, and video (optional code) —
            private folder indexing, not a cloud drive. Based on DigUp (MIT); not an official DigUp product.
          </p>

          <div class="download-grid" aria-label="Download Digup Run">
            <a class="dl-card" href={SITE.appReleasesLatest} rel="noopener noreferrer">
              <span class="dl-os">Mac</span>
              <span class="dl-meta">Apple Silicon · macOS 14+</span>
              <span class="dl-cta">Download DMG →</span>
            </a>
            <a class="dl-card" href={SITE.appReleases} rel="noopener noreferrer">
              <span class="dl-os">Windows</span>
              <span class="dl-meta">x64 · Win 10/11 · beta</span>
              <span class="dl-cta">Download installer →</span>
            </a>
            <a class="dl-card" href={SITE.appReleases} rel="noopener noreferrer">
              <span class="dl-os">Linux</span>
              <span class="dl-meta">.deb · AppImage · amd64 · beta</span>
              <span class="dl-cta">Download package →</span>
            </a>
          </div>
          <p class="hero-brew muted">
            All builds ship from
            <a href={SITE.appReleases} rel="noopener noreferrer">ylwl1997/digup-run-app Releases</a>
            — this site never hosts binaries. Install guides:
            <a href="/install-mac/">Mac</a> ·
            <a href="/install-windows/">Windows</a> ·
            <a href="/install-linux/">Linux</a>
          </p>
        </div>

        <figure class="shot-panel">
          <span class="shot-label">Search UI · Mac (illustrative)</span>
          <img
            src={DIGUP_UI.hero.src}
            width="1200"
            height="800"
            alt={DIGUP_UI.hero.altEn}
            loading="eager"
            decoding="async"
          />
          <figcaption class="shot-caption">{DIGUP_UI.sourceNoteEn} Query: “zebra in a video” → open at 0:42.</figcaption>
        </figure>
      </div>
    </section>

    <section class="wrap section-head">
      <p class="section-label">Product</p>
      <h2>What Digup Run does</h2>
      <p class="muted">Same job every time: say what you remember about the contents; open to the place inside the file.</p>
      <div class="scenarios">
        <article class="scenario">
          <span class="mod-pill text">PDF / docs</span>
          <p class="query-line">the clause about pets in the lease</p>
          <ul class="flow">
            <li><span class="k">Find</span> <span>Meaning match in a long PDF</span></li>
            <li><span class="k">Open</span> <span><strong>Page</strong> in your PDF viewer</span></li>
          </ul>
        </article>
        <article class="scenario">
          <span class="mod-pill video">Video</span>
          <p class="query-line">zebra in a video</p>
          <ul class="flow">
            <li><span class="k">Find</span> <span>Frame + soundtrack window</span></li>
            <li><span class="k">Open</span> <span>Clip at the <strong>moment</strong></span></li>
          </ul>
        </article>
        <article class="scenario">
          <span class="mod-pill audio">Audio</span>
          <p class="query-line">where they talk about sleep</p>
          <ul class="flow">
            <li><span class="k">Find</span> <span>~30s audio window by meaning</span></li>
            <li><span class="k">Open</span> <span>Podcast at that <strong>minute</strong></span></li>
          </ul>
        </article>
      </div>
    </section>

    <section class="wrap section-head">
      <p class="section-label">Modalities</p>
      <h2>Content, not filenames alone</h2>
      <div class="modality-grid">
        <div class="modality image"><div class="icon" aria-hidden="true">▣</div><h3>Images</h3><p>Photos &amp; screenshots by what’s shown</p></div>
        <div class="modality text"><div class="icon" aria-hidden="true">¶</div><h3>PDFs / docs</h3><p>Pages &amp; passages → open to page</p></div>
        <div class="modality audio"><div class="icon" aria-hidden="true">♫</div><h3>Audio</h3><p>Meaning in ~30s windows → timestamp</p></div>
        <div class="modality video"><div class="icon" aria-hidden="true">▶</div><h3>Video</h3><p>Frames + sound → moment</p></div>
        <div class="modality code"><div class="icon" aria-hidden="true">&lbrace;&rbrace;</div><h3>Code</h3><p>Optional <code>code:</code> → line</p></div>
        <div class="modality local"><div class="icon" aria-hidden="true">⌂</div><h3>On-device</h3><p>Folders you pick · no cloud index</p></div>
      </div>
    </section>

    <section class="wrap section-head">
      <p class="section-label">UI</p>
      <h2>Search → results → open to page / time</h2>
      <p class="muted">{DIGUP_UI.sourceNoteEn}</p>
      <div class="shot-gallery">
        <figure class="shot-panel">
          <span class="shot-label">Windows · PDF</span>
          <img src={DIGUP_UI.pdf.src} width="1200" height="800" alt={DIGUP_UI.pdf.altEn} loading="lazy" decoding="async" />
        </figure>
        <figure class="shot-panel">
          <span class="shot-label">Mac · Audio</span>
          <img src={DIGUP_UI.audio.src} width="1200" height="800" alt={DIGUP_UI.audio.altEn} loading="lazy" decoding="async" />
        </figure>
        <figure class="shot-panel">
          <span class="shot-label">Windows · Multimodal</span>
          <img src={DIGUP_UI.multimodal.src} width="1200" height="800" alt={DIGUP_UI.multimodal.altEn} loading="lazy" decoding="async" />
        </figure>
        <figure class="shot-panel">
          <span class="shot-label">Linux · Code</span>
          <img src={DIGUP_UI.code.src} width="1200" height="800" alt={DIGUP_UI.code.altEn} loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="wrap section-head">
      <p class="section-label">Guides</p>
      <h2>Install &amp; learn Digup Run</h2>
      <div class="cards">
        <a class="card" href="/install-mac/"><span class="tag">Mac</span><h3>Install on Mac</h3><p>DMG from our Releases, first-run model, ⇧⌘Space.</p></a>
        <a class="card" href="/install-windows/"><span class="tag">Windows</span><h3>Install on Windows</h3><p>x64 setup from our Releases, SmartScreen notes.</p></a>
        <a class="card" href="/install-linux/"><span class="tag">Linux</span><h3>Install on Linux</h3><p>digup-run .deb or AppImage from our Releases.</p></a>
        <a class="card" href="/what-is-digup/"><span class="tag">Overview</span><h3>What is Digup Run?</h3><p>Modalities, indexing, and OS requirements.</p></a>
        <a class="card" href="/vs-spotlight/"><span class="tag">Compare</span><h3>vs Spotlight</h3><p>Filenames vs meaning — when to use both.</p></a>
        <a class="card" href="/embeddinggemma-2/"><span class="tag">Model</span><h3>EmbeddingGemma 2</h3><p>Local Google model via llama.cpp (~865 MB).</p></a>
        <a class="card" href="/faq/"><span class="tag">Support</span><h3>FAQ</h3><p>Privacy, Intel Mac, indexing time, code search.</p></a>
        <a class="card" href="/zh/"><span class="tag">中文</span><h3>中文首页</h3><p>下载与安装指南中文版（/zh/）。</p></a>
      </div>
      <div class="cta-bar">
        <a class="cta" href={SITE.appReleases} rel="noopener noreferrer">All GitHub Releases</a>
        <a class="cta-secondary" href={SITE.appRepo} rel="noopener noreferrer">App source</a>
        <a class="cta-secondary" href={SITE.upstreamRepo} rel="noopener noreferrer">Upstream DigUp (MIT)</a>
      </div>
    </section>
  </main>
</Layout>
