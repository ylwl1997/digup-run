---
import Layout from '../layouts/Layout.astro';
import { DIGUP_UI, SITE } from '../lib/site';
---
<Layout
  title="DigUp — Download local multimodal semantic file search"
  description="Download DigUp for Mac, Windows, and Linux. On-device EmbeddingGemma 2 search for photos, PDFs, audio, video, and code."
  canonicalPath="/"
  lang="en"
  ogImage={DIGUP_UI.hero.src}
>
  <main class="home-main">
    <section class="stage wrap-wide">
      <p class="stage-eyebrow">Local multimodal search · digup.run</p>
      <h1>Describe it. Dig it up on your machine.</h1>
      <p class="stage-lede">
        DigUp finds what’s <em>inside</em> photos, PDFs, docs, audio, and video —
        private folder indexing with EmbeddingGemma 2. Not a cloud drive. Not a launcher.
      </p>

      <div class="dl-arch" id="download" aria-label="Download DigUp">
        <a class="dl-primary" href={SITE.downloads.mac} rel="noopener noreferrer" download>
          <span class="dl-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 15 2.94 10.53 4.7 7.5c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.22-2 1.08-3.15-1.05.04-2.31.72-3.05 1.58-.66.76-1.23 1.98-1.08 3.14 1.14.09 2.32-.65 3.05-1.57"/></svg></span>
          <span class="dl-copy">
            <strong>Download DigUp for Mac</strong>
            <span>Apple Silicon · macOS 14+ · DMG · <em class="ver">{SITE.downloads.macVersion}</em></span>
          </span>
        </a>
        <div class="dl-secondary">
          <a class="dl-pill" href={SITE.downloads.windows} rel="noopener noreferrer" download>
            <span class="os-ico" aria-hidden="true">▦</span>
            Windows <em>beta</em>
            <span class="ver-chip">{SITE.downloads.windowsVersion}</span>
          </a>
          <a class="dl-pill" href={SITE.downloads.linuxDeb} rel="noopener noreferrer" download>
            <span class="os-ico" aria-hidden="true">⬡</span>
            Linux .deb
            <span class="ver-chip">{SITE.downloads.linuxVersion}</span>
          </a>
          <a class="dl-pill" href={SITE.downloads.linuxAppImage} rel="noopener noreferrer" download>
            <span class="os-ico" aria-hidden="true">⬡</span>
            Linux AppImage
            <span class="ver-chip">{SITE.downloads.linuxVersion}</span>
          </a>
        </div>
      </div>
      <p class="stage-note">
        Guides: <a href="/install-mac/">Mac</a> · <a href="/install-windows/">Windows</a> · <a href="/install-linux/">Linux</a>
      </p>

      <!-- Primary product proof: DigUp demo (MIT), self-hosted -->
      <figure class="app-window demo-stage">
        <div class="app-chrome" aria-hidden="true">
          <div class="app-dots"><i></i><i></i><i></i></div>
          <div class="app-chrome-title">DigUp · Demo</div>
        </div>
        <div class="demo-media">
          <video
            class="demo-video"
            width="1200"
            height="800"
            poster={DIGUP_UI.demo.poster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={DIGUP_UI.demo.altEn}
          >
            <source src={DIGUP_UI.demo.webm} type="video/webm" />
            <source src={DIGUP_UI.demo.mp4} type="video/mp4" />
            <img src={DIGUP_UI.demo.gif} width="1200" height="800" alt={DIGUP_UI.demo.altEn} />
          </video>
        </div>
      </figure>

      <!-- Real demo -->
      <section class="real-demo" aria-labelledby="real-demo-heading">
        <div class="real-demo-head">
          <p class="kicker">Real demo</p>
          <h2 id="real-demo-heading">DigUp in use</h2>
          <p class="muted">Natural-language search across video, audio, PDF, and code.</p>
        </div>
        <figure class="app-window real-demo-stage">
          <div class="app-chrome" aria-hidden="true">
            <div class="app-dots"><i></i><i></i><i></i></div>
            <div class="app-chrome-title">DigUp · Real demo</div>
          </div>
          <div class="demo-media">
            <video
              class="demo-video"
              controls
              playsinline
              preload="metadata"
              poster="/media/xiaohu-digup-demo-poster.jpg"
              width="1000"
              height="720"
            >
              <source src="/media/xiaohu-digup-demo.mp4" type="video/mp4" />
            </video>
          </div>
        </figure>
      </section>

      <!-- Windows search UI product framing -->
      <div class="proof-split">
        <figure class="proof-shot">
          <span class="film-label">Windows · Search UI</span>
          <img
            src={DIGUP_UI.multimodal.src}
            width="1200"
            height="800"
            alt={DIGUP_UI.multimodal.altEn}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="proof-copy">
          <p class="kicker">Product proof</p>
          <h2>Search by what’s inside — grouped by type</h2>
          <p class="muted">
            The Windows search panel shows results in a sidebar by modality
            (<strong>VIDEO</strong> · <strong>IMAGES</strong> · <strong>AUDIO</strong> · <strong>DOCUMENTS</strong>),
            with a preview pane that lands on the match — e.g. “Matches the frame at 0:12”.
          </p>
          <ul class="proof-types" aria-label="Result types">
            <li><span class="t video">VIDEO</span> Open at the moment</li>
            <li><span class="t image">IMAGES</span> Match what’s shown</li>
            <li><span class="t audio">AUDIO</span> Jump to the minute</li>
            <li><span class="t docs">DOCUMENTS</span> Open to the page</li>
          </ul>
        </div>
      </div>

      <div class="trust-rail" role="list">
        <div class="trust-item" role="listitem">
          <strong>On-device</strong>
          <span>Folders you pick. No cloud index of your files.</span>
        </div>
        <div class="trust-item" role="listitem">
          <strong>Open to location</strong>
          <span>Jump to page, timestamp, or line — not just the file.</span>
        </div>
        <div class="trust-item" role="listitem">
          <strong>Open source</strong>
          <span>MIT-licensed desktop app for local folders.</span>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="band-head">
          <p class="kicker">How it feels</p>
          <h2>Say what you remember. Land inside the file.</h2>
          <p>Same job every time: natural language for content — then open at the place that matches.</p>
        </div>
        <div class="bento">
          <article class="bento-feat">
            <span class="mod-pill text">PDF / docs</span>
            <p class="query">the clause about pets in the lease</p>
            <p class="outcome">Meaning match in a long PDF → open to the <strong>page</strong> in your viewer.</p>
          </article>
          <article class="bento-side">
            <span class="mod-pill video">Video</span>
            <p class="query">zebra in a video</p>
            <p class="outcome">Frame + soundtrack → clip at the <strong>moment</strong>.</p>
          </article>
          <article class="bento-side">
            <span class="mod-pill audio">Audio</span>
            <p class="query">where they talk about sleep</p>
            <p class="outcome">~30s meaning window → podcast at that <strong>minute</strong>.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="band-head">
          <p class="kicker">UI</p>
          <h2>Search → results → open to page / time</h2>
          <p>Search UI across Mac, Windows, and Linux.</p>
        </div>
        <div class="filmstrip">
          <figure class="film-main">
            <span class="film-label">Windows · PDF</span>
            <img src={DIGUP_UI.pdf.src} width="1200" height="800" alt={DIGUP_UI.pdf.altEn} loading="lazy" decoding="async" />
          </figure>
          <div class="film-side">
            <figure>
              <span class="film-label">Mac · Audio</span>
              <img src={DIGUP_UI.audio.src} width="1200" height="800" alt={DIGUP_UI.audio.altEn} loading="lazy" decoding="async" />
            </figure>
            <figure>
              <span class="film-label">Linux · Code</span>
              <img src={DIGUP_UI.code.src} width="1200" height="800" alt={DIGUP_UI.code.altEn} loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="band-head">
          <p class="kicker">Modalities</p>
          <h2>Content, not filenames alone</h2>
          <p>Images, PDFs, audio, video, optional code — all local.</p>
        </div>
        <div class="mod-strip" aria-label="Supported modalities">
          <span class="mod-chip image"><span class="ico" aria-hidden="true">▣</span> Images</span>
          <span class="mod-chip text"><span class="ico" aria-hidden="true">¶</span> PDFs / docs</span>
          <span class="mod-chip audio"><span class="ico" aria-hidden="true">♫</span> Audio</span>
          <span class="mod-chip video"><span class="ico" aria-hidden="true">▶</span> Video</span>
          <span class="mod-chip code"><span class="ico" aria-hidden="true">&lbrace;&rbrace;</span> Code</span>
          <span class="mod-chip local"><span class="ico" aria-hidden="true">⌂</span> On-device</span>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="band-head">
          <p class="kicker">Guides</p>
          <h2>Install &amp; learn DigUp</h2>
          <p>Install notes and digup SEO guides.</p>
        </div>
        <div class="guide-list">
          <a class="guide-link" href="/install-mac/">
            <span class="gl-meta"><span class="gl-tag">Mac</span><span class="gl-title">Install on Mac</span></span>
            <span class="gl-arrow" aria-hidden="true">→</span>
          </a>
          <a class="guide-link" href="/install-windows/">
            <span class="gl-meta"><span class="gl-tag">Windows</span><span class="gl-title">Install on Windows</span></span>
            <span class="gl-arrow" aria-hidden="true">→</span>
          </a>
          <a class="guide-link" href="/install-linux/">
            <span class="gl-meta"><span class="gl-tag">Linux</span><span class="gl-title">Install on Linux</span></span>
            <span class="gl-arrow" aria-hidden="true">→</span>
          </a>
          <a class="guide-link" href="/what-is-digup/">
            <span class="gl-meta"><span class="gl-tag">Overview</span><span class="gl-title">What is DigUp?</span></span>
            <span class="gl-arrow" aria-hidden="true">→</span>
          </a>
          <a class="guide-link" href="/vs-spotlight/">
            <span class="gl-meta"><span class="gl-tag">Compare</span><span class="gl-title">vs Spotlight</span></span>
            <span class="gl-arrow" aria-hidden="true">→</span>
          </a>
          <a class="guide-link" href="/embeddinggemma-2/">
            <span class="gl-meta"><span class="gl-tag">Model</span><span class="gl-title">EmbeddingGemma 2</span></span>
            <span class="gl-arrow" aria-hidden="true">→</span>
          </a>
          <a class="guide-link" href="/faq/">
            <span class="gl-meta"><span class="gl-tag">Support</span><span class="gl-title">FAQ</span></span>
            <span class="gl-arrow" aria-hidden="true">→</span>
          </a>
          <a class="guide-link" href="/zh/">
            <span class="gl-meta"><span class="gl-tag">中文</span><span class="gl-title">中文首页</span></span>
            <span class="gl-arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="bottom-cta">
          <p><strong>Ready to dig?</strong> Download DigUp for your platform.</p>
          <div class="actions">
            <a class="cta" href={SITE.downloads.mac} rel="noopener noreferrer" download>Mac DMG</a>
            <a class="cta-secondary" href={SITE.downloads.windows} rel="noopener noreferrer" download>Windows</a>
            <a class="cta-secondary" href={SITE.upstreamRepo} rel="noopener noreferrer">ARahim3/DigUp</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
